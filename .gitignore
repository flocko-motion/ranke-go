bin/
dist/
coverage.out
coverage-core.out

# Stray binaries from `go build ./cmd/<tool>` at repo root.
/scenariodoc

# Scenario binaries land at repo root when invoked as
# `go build ./conformance/scenarios/<name>` from there.
/01_*
/02_*
/03_*

# Per-scenario generated output bundle — compared against the
# committed data_reference/ by `make verify-scenarios`.
conformance/scenarios/*/data/

# Local copy of the spec, kept at repo root for convenience.
/specification.typ
/specification.txt

# Foundational papers pulled fresh from ranke-graph by `make docs` —
# fetched, never committed.
docs/papers/

# Local Claude config
/.claude/

# Sindri runtime hub (sockets, local db) — not source.
/.sindri/

# sindri hub artifacts (agent worktrees + hub state) — not for the repo
.worktrees/
.todos/


